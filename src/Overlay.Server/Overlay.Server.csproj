<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <AssemblyName>sharpsticks-overlay-cli</AssemblyName>
    </PropertyGroup>

    <!--
        The CLI is the only piece that picks a concrete platform: PlatformInput supplies
        PlatformDefaultInputDevice.Factory. All reusable server logic lives in the
        platform-agnostic Overlay.WebSockets library.
    -->
    <ItemGroup>
        <ProjectReference Include="..\Overlay.WebSockets\Overlay.WebSockets.csproj"/>
        <ProjectReference Include="..\PlatformInput\PlatformInput.csproj"/>
    </ItemGroup>

</Project>
